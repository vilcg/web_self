---
import Base from '../layouts/Base.astro';
import Avatar from '../components/Avatar.astro';
import PostList from '../components/PostList.astro';
import { getPosts, url } from '../lib/site';
const posts = await getPosts();
---
<Base>
  <section class="profile" aria-labelledby="profile-heading">
    <Avatar />
    <div class="profile-copy">
      <h1 id="profile-heading">你好，我是 vilcg<span class="hello-dot">。</span></h1>
      <p>在学习中探索，在生活里留下痕迹。<br />记录大学日常、学习笔记，以及动手做出来的小作品。</p>
      <div class="profile-links"><a href="https://github.com/vilcg">GitHub ↗</a><a href={url('about/')}>关于我 →</a></div>
    </div>
  </section>
  <section class="section latest" aria-labelledby="recent-heading">
    <div class="section-heading"><h2 id="recent-heading">最近写下的</h2><a class="text-link" href={url('posts/')}>全部文章 →</a></div>
    <PostList posts={posts.slice(0, 3)} />
  </section>
  <section class="now-card" aria-labelledby="now-heading"><span class="eyebrow"><span class="status-dot"></span> 此刻</span><h2 id="now-heading">一边学习，一边把想法落地。</h2><p>从一个简单的博客开始，练习写作，也练习把代码变成看得见的作品。</p><div class="tag-cloud"><span>Web 开发</span><span>学习方法</span><span>大学日常</span></div></section>
  <section class="project-strip"><div><h2>让想法，有一个着落。</h2><p>小工具、实验与个人项目，记录从想法到实现的过程。</p></div><a class="text-link" href={url('projects/')}>看看项目 →</a></section>
</Base>
