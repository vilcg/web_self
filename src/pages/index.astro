---
import Base from '../layouts/Base.astro';
import Avatar from '../components/Avatar.astro';
import PostList from '../components/PostList.astro';
import { getPosts, url } from '../lib/site';
const posts = await getPosts();
---
<Base>
  <section class="profile" aria-labelledby="profile-heading">
    <Avatar />
    <div class="profile-copy">
      <h1 id="profile-heading">你好，我是 vilcg</h1>
      <p>在学习中探索，在生活里留下痕迹。<br />记录大学日常、学习笔记，以及动手做出来的小作品。</p>
      <div class="profile-links">
        <a class="icon-link" href="https://github.com/vilcg" aria-label="GitHub：vilcg" title="GitHub">
          <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 .9a11.1 11.1 0 0 0-3.51 21.63c.56.1.76-.24.76-.54v-2.08c-3.1.68-3.76-1.32-3.76-1.32-.51-1.3-1.24-1.65-1.24-1.65-1.01-.69.08-.68.08-.68 1.12.08 1.71 1.15 1.71 1.15 1 1.7 2.62 1.21 3.26.92.1-.72.39-1.21.71-1.49-2.47-.28-5.07-1.24-5.07-5.5 0-1.21.43-2.2 1.15-2.98-.12-.28-.5-1.42.11-2.95 0 0 .94-.3 3.05 1.14a10.6 10.6 0 0 1 5.55 0c2.12-1.44 3.05-1.14 3.05-1.14.61 1.53.23 2.67.11 2.95.72.78 1.15 1.77 1.15 2.98 0 4.27-2.6 5.21-5.08 5.49.4.35.75 1.02.75 2.06v3.1c0 .3.2.65.77.54A11.1 11.1 0 0 0 12 .9Z"/></svg>
        </a>
        <a class="icon-link" href={url('about/')} aria-label="关于我" title="关于我">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="8" r="3.2"/><path d="M5.5 20c.5-3.3 2.7-5.1 6.5-5.1s6 1.8 6.5 5.1"/></svg>
        </a>
      </div>
    </div>
  </section>
  <section class="section latest" aria-labelledby="recent-heading">
    <div class="section-heading"><h2 id="recent-heading">最近写下的</h2><a class="text-link" href={url('posts/')}>全部文章 →</a></div>
    <PostList posts={posts.slice(0, 3)} />
  </section>
</Base>
