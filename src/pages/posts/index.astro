---
import Base from '../../layouts/Base.astro';
import PostList from '../../components/PostList.astro';
import { getPosts } from '../../lib/site';
const posts = await getPosts();
const categories = ['全部', '学习笔记', '生活随记', '建站记录'];
---
<Base title="文章" description="生活随记、学习笔记与建站记录。">
  <header class="page-heading"><h1>文章</h1><p>学习笔记、生活记录与建站过程，共 {posts.length} 篇手记</p></header>
  <div class="filters" role="group" aria-label="按分类筛选">{categories.map((category, index) => <button type="button" data-category={category} aria-pressed={index === 0}>{category}</button>)}</div>
  <div class="archive-list"><PostList posts={posts} /></div>
  <p class="filter-status" aria-live="polite">显示全部 {posts.length} 篇文章</p>
</Base>
<script>
  const buttons = document.querySelectorAll<HTMLButtonElement>('[data-category]');
  const rows = document.querySelectorAll<HTMLElement>('.archive-list .post-row');
  buttons.forEach(button => button.addEventListener('click', () => {
    const category = button.dataset.category;
    buttons.forEach(item => item.setAttribute('aria-pressed', String(item === button)));
    let count = 0;
    rows.forEach(row => {
      const match = category === '全部' || row.querySelector('.post-meta span')?.textContent === category;
      row.hidden = !match;
      if (match) count++;
    });
    const status = document.querySelector('.filter-status');
    if (status) status.textContent = `显示 ${count} 篇${category === '全部' ? '' : category}文章`;
  }));
</script>
