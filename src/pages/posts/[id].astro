---
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { getPosts, url, formatDate } from '../../lib/site';
export async function getStaticPaths() {
  return (await getPosts()).map(post => ({ params: { id: post.id }, props: { post } }));
}
const { post } = Astro.props;
const { Content, headings } = await render(post);
---
<Base title={post.data.title} description={post.data.description}>
  <div class="article-top"><a class="text-link" href={url('posts/')}>← 返回全部文章</a></div>
  <header class="article-heading"><div class="post-meta"><span>{post.data.category}</span><time datetime={post.data.date.toISOString()}>{formatDate(post.data.date)}</time></div><h1>{post.data.title}</h1><p>{post.data.description}</p><div class="tag-cloud">{post.data.tags.map(tag => <span>#{tag}</span>)}</div></header>
  {post.data.sample && <p class="notice">这是一篇示例文章，用于演示排版与写作方式，不代表作者的真实经历。</p>}
  <div class="article-layout"><article class="prose"><Content /><div class="article-end">— 写到这里，下次继续。—</div></article>
  {headings.length > 0 && <aside class="toc"><span class="eyebrow">ON THIS PAGE</span><h2>这一篇的线索</h2><nav aria-label="文章目录">{headings.filter(h => h.depth <= 3).map(h => <a href={`#${h.slug}`} class:list={{ 'toc-sub': h.depth === 3 }}>{h.text}</a>)}</nav></aside>}</div>
</Base>
