---
import '../styles/global.css';
import { site, url } from '../lib/site';
interface Props { title?: string; description?: string; }
const { title, description = site.description } = Astro.props;
const current = Astro.url.pathname;
const nav = [['', '首页'], ['posts/', '文章'], ['projects/', '项目'], ['about/', '关于']];
---
<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#fdfcf9" />
    <link rel="icon" type="image/svg+xml" href={url('favicon.svg')} />
    <title>{title ? `${site.name} ${title}` : `${site.name} ${site.author} 的个人博客`}</title>
  </head>
  <body>
    <a class="skip-link" href="#main">跳到正文</a>
    <header class="site-header shell">
      <a class="brand" href={url()} aria-label="大学手记首页">{site.name}</a>
      <nav aria-label="主导航">{nav.map(([path, label]) => {
        const active = path ? current.startsWith(url(path)) : current === url() || current === url().replace(/\/$/, '');
        return <a href={url(path)} aria-current={active ? 'page' : undefined}>{label}</a>;
      })}</nav>
    </header>
    <main id="main" class="shell"><slot /></main>
    <footer class="shell site-footer">
      <p>© {new Date().getFullYear()} vilcg</p>
      <div class="footer-links">
        <span>用 Astro 构建</span>
        <a class="footer-github" href="https://github.com/vilcg/web_self" aria-label="GitHub 仓库" title="GitHub 仓库">
          <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 .9a11.1 11.1 0 0 0-3.51 21.63c.56.1.76-.24.76-.54v-2.08c-3.1.68-3.76-1.32-3.76-1.32-.51-1.3-1.24-1.65-1.24-1.65-1.01-.69.08-.68.08-.68 1.12.08 1.71 1.15 1.71 1.15 1 1.7 2.62 1.21 3.26.92.1-.72.39-1.21.71-1.49-2.47-.28-5.07-1.24-5.07-5.5 0-1.21.43-2.2 1.15-2.98-.12-.28-.5-1.42.11-2.95 0 0 .94-.3 3.05 1.14a10.6 10.6 0 0 1 5.55 0c2.12-1.44 3.05-1.14 3.05-1.14.61 1.53.23 2.67.11 2.95.72.78 1.15 1.77 1.15 2.98 0 4.27-2.6 5.21-5.08 5.49.4.35.75 1.02.75 2.06v3.1c0 .3.2.65.77.54A11.1 11.1 0 0 0 12 .9Z"/></svg>
        </a>
      </div>
    </footer>
  </body>
</html>
