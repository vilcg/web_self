---
import type { CollectionEntry } from 'astro:content';
import { url, formatDate } from '../lib/site';
interface Props { posts: CollectionEntry<'posts'>[]; }
const { posts } = Astro.props;
---
<div class="post-list">{posts.map((post, index) => <article class="post-row">
  <span class="post-number">{String(index + 1).padStart(2, '0')}</span>
  <div><div class="post-meta"><span>{post.data.category}</span><time datetime={post.data.date.toISOString()}>{formatDate(post.data.date)}</time>{post.data.sample && <span class="sample-label">示例</span>}</div>
  <h3><a href={url(`posts/${post.id}/`)}>{post.data.title}</a></h3><p>{post.data.description}</p></div>
  <a class="row-arrow" href={url(`posts/${post.id}/`)} aria-label={`阅读：${post.data.title}`}>↗</a>
</article>)}</div>
